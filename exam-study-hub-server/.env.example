# 复制本文件为 .env 并填入真实值（.env 不会提交到 git）
# 数据库连接串：postgresql+psycopg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/exam_study

# 允许跨域访问的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173

# JWT 签名密钥：生产环境务必改成随机长串（如 `openssl rand -hex 32` 生成）
SECRET_KEY=change-me-to-a-random-long-string

# Resend：验证自有域名后创建 API Key，发件地址必须属于已验证域名
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=上岸计划 <no-reply@auth.example.com>

# Cloudflare Turnstile 服务端 Secret Key（不是前端 Site Key）
TURNSTILE_SECRET_KEY=xxxxxxxxx

# 以下为可选的验证码安全策略
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_DAILY_LIMIT=5
EMAIL_CODE_IP_HOURLY_LIMIT=20
EMAIL_CODE_MAX_ATTEMPTS=5
